# PostgreSQL. Use Supavisor transaction mode for DATABASE_URL in serverless
# production and session/direct mode for DIRECT_URL migrations.
DATABASE_URL="postgresql://talie:talie_dev_password@localhost:5433/talie_dev?schema=public"
# Optional direct/non-pooled connection used by migrations; falls back to DATABASE_URL.
DIRECT_URL="postgresql://talie:talie_dev_password@localhost:5433/talie_dev?schema=public"

# Supabase project and Storage. The publishable key is browser-safe; the secret
# key is server-only and must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
SUPABASE_SECRET_KEY="sb_secret_replace_me"
SUPABASE_STORAGE_BUCKET="talie-catalog"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Comma-separated hostnames only. Quick Tunnel hostnames change when restarted.
DEV_ALLOWED_ORIGINS=""

# Added in the authentication, upload, and email chunks
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
RESEND_API_KEY=""
# Use onboarding@resend.dev only while testing. Customer delivery requires a
# sender on a domain verified in Resend.
RESEND_FROM_EMAIL="Talié <onboarding@resend.dev>"

# Used only by `npm run admin:ensure`; do not commit real credentials.
